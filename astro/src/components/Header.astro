---
import { type Locale } from "../lib/corpus";
import { getDict } from "../lib/dictionary";
import { homeUrl } from "../lib/urls";
import NavDrawer from "./NavDrawer.astro";

interface Props {
  locale: Locale;
  /** The locale-neutral English path of the current page, for `aria-current`. */
  path?: string;
}

const { locale, path = "" } = Astro.props;
const dict = getDict(locale);
---

<header class="site-header">
  <div class="bar">
    <a class="wordmark" href={homeUrl(locale)}>{dict.siteName}</a>
    <button
      class="burger"
      id="nav-trigger"
      type="button"
      aria-expanded="false"
      aria-controls="nav-drawer"
      aria-label={dict.menuOpen}
      data-open-label={dict.menuOpen}
      data-close-label={dict.menuClose}
    >
      <span aria-hidden="true">☰</span>
    </button>
    <NavDrawer locale={locale} path={path} />
  </div>
</header>

<script>
  const burger = document.getElementById("nav-trigger");
  const drawer = document.getElementById("nav-drawer");
  const glyph = burger?.querySelector("span");
  const header = document.querySelector(".site-header");

  let menuOpen = false;

  if (burger && drawer && glyph) {
    // The burger is the toggle in both directions and becomes a close button
    // while the menu is open. That is why the menu is a plain panel rather than
    // a modal dialog: a modal backdrop would make the burger unclickable.
    const setOpen = (open: boolean) => {
      menuOpen = open;
      drawer.hidden = !open;
      burger.setAttribute("aria-expanded", String(open));
      glyph.textContent = open ? "✕" : "☰";
      const label = open ? burger.dataset.closeLabel : burger.dataset.openLabel;
      if (label) burger.setAttribute("aria-label", label);
    };

    // `HTMLElement.hidden` is typed `boolean | "until-found"`, so the state is
    // read back off the attribute instead of off the property.
    const isOpen = () => !drawer.hasAttribute("hidden");

    burger.addEventListener("click", () => {
      const open = !isOpen();
      setOpen(open);
      if (open) drawer.querySelector("a")?.focus();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        setOpen(false);
        burger.focus();
      }
    });

    // Light dismiss. The burger is excluded so its own click is not undone by
    // the same event bubbling up to here.
    document.addEventListener("click", (event) => {
      if (!isOpen()) return;
      const target = event.target as Node;
      if (!drawer.contains(target) && !burger.contains(target)) setOpen(false);
    });
  }

  // The header slides away on the way down and comes straight back on the first
  // upward scroll, so the menu is one small pull away at any depth in a lesson.
  if (header) {
    const HIDE_AFTER = 200;
    const THRESHOLD = 4;
    let lastY = window.scrollY;

    window.addEventListener(
      "scroll",
      () => {
        const y = window.scrollY;
        const delta = y - lastY;
        // Ignore sub-pixel jitter, which would otherwise flicker the header.
        if (Math.abs(delta) < THRESHOLD) return;
        // Never hide it while its own menu is open: the menu lives inside it.
        const hide = delta > 0 && y > HIDE_AFTER && !menuOpen;
        header.classList.toggle("is-hidden", hide);
        lastY = y;
      },
      { passive: true },
    );
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    /* Opaque, or the page shows through the bar as it scrolls underneath. */
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
    transition: transform 0.2s ease;
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .bar {
    /* Positioning context for the menu, which opens under the burger. */
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: 0.5rem 1rem;
  }

  .wordmark {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--fg);
    text-decoration: none;
  }

  .burger {
    /* The burger is the only navigation entry point, at every width. */
    margin-inline-start: auto;
    min-width: 44px;
    min-height: 44px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: none;
    color: var(--fg);
    font-size: 1.125rem;
    cursor: pointer;
  }
</style>
