---
import { TOPICS, topicTitle, type Locale } from "../lib/corpus";
import { getDict } from "../lib/dictionary";
import { aboutUrl, entriesUrl, homeUrl, privacyUrl, searchUrl, topicUrl } from "../lib/urls";

interface Props {
  locale: Locale;
  /** The locale-neutral English path of the current page, for `aria-current`. */
  path?: string;
}

const { locale, path = "" } = Astro.props;
const dict = getDict(locale);

const items = [
  { href: homeUrl(locale), en: homeUrl("en"), label: dict.navHome },
  ...TOPICS.map((topic) => ({
    href: topicUrl(locale, topic),
    en: topicUrl("en", topic),
    label: topicTitle(topic),
  })),
  { href: entriesUrl(locale), en: entriesUrl("en"), label: dict.navEntries },
  { href: searchUrl(locale), en: searchUrl("en"), label: dict.navSearch },
  { href: aboutUrl(locale), en: aboutUrl("en"), label: dict.navAbout },
  { href: privacyUrl(locale), en: privacyUrl("en"), label: dict.navPrivacy },
];
---

<dialog id="nav-drawer" aria-label={dict.navLabel}>
  <div class="drawer-head">
    <button class="close" id="nav-close" type="button" aria-label={dict.menuClose}>
      <span aria-hidden="true">✕</span>
    </button>
  </div>
  <nav aria-label={dict.navLabel}>
    <ul>
      {
        items.map((item) => (
          <li>
            <a href={item.href} aria-current={path === item.en ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</dialog>

<script>
  const drawer = document.getElementById("nav-drawer");

  if (drawer instanceof HTMLDialogElement) {
    // The burger lives in Header and cannot call this directly, so it asks.
    drawer.addEventListener("nav:open", () => drawer.showModal());

    // Close on activation: on a phone the drawer is the only way to navigate.
    drawer.querySelectorAll("a[href]").forEach((link) => {
      link.addEventListener("click", () => drawer.close());
    });
    document.getElementById("nav-close")?.addEventListener("click", () => drawer.close());

    // Rotating to landscape (or resizing past the breakpoint) would otherwise
    // leave a modal stranded in the browser's top layer, where no CSS reaches it.
    matchMedia("(min-width: 64rem)").addEventListener("change", (event) => {
      if (event.matches) drawer.close();
    });
  }
</script>

<style>
  #nav-drawer {
    width: min(22rem, 90vw);
    margin: 0 0 0 auto;
    padding: 1rem;
    border: 0;
    max-height: 100dvh;
    overflow-y: auto;
    background-color: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
  }

  #nav-drawer::backdrop {
    background-color: rgb(0 0 0 / 40%);
  }

  .drawer-head {
    display: flex;
    justify-content: flex-end;
  }

  #nav-drawer .close {
    min-width: 44px;
    min-height: 44px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: none;
    color: var(--fg);
    font-size: 1rem;
    cursor: pointer;
  }

  #nav-drawer ul {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  #nav-drawer li {
    margin-bottom: 0.25rem;
  }

  #nav-drawer a {
    display: block;
    padding: 0.5rem 0.25rem;
    color: var(--fg);
    text-decoration: none;
  }

  #nav-drawer a:hover {
    text-decoration: underline;
  }

  #nav-drawer a[aria-current="page"] {
    color: var(--accent);
    font-weight: 600;
  }

  @media (min-width: 64rem) {
    #nav-drawer {
      /* `revert` would roll back to the UA stylesheet, whose
         `dialog:not([open]) { display: none }` then wins. */
      display: block;
      position: static;
      width: auto;
      margin: 0;
      max-width: none;
      max-height: none;
      padding: 0;
      overflow: visible;
      background: none;
      margin-inline-start: auto;
    }

    .drawer-head {
      display: none;
    }

    #nav-drawer ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 0.75rem;
      margin: 0;
      font-size: 0.9375rem;
    }

    #nav-drawer li {
      margin: 0;
    }

    #nav-drawer a {
      padding: 0.5rem 0.25rem;
    }
  }
</style>
