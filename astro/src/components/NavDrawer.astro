---
import { TOPICS, topicTitle, type Locale } from "../lib/corpus";
import { getDict } from "../lib/dictionary";
import {
  aboutUrl,
  entriesUrl,
  homeUrl,
  privacyUrl,
  searchUrl,
  switchLocale,
  topicUrl,
} from "../lib/urls";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  /** The locale-neutral English path of the current page, for `aria-current`. */
  path?: string;
}

const { locale, path = "" } = Astro.props;
const dict = getDict(locale);

const other: Locale = locale === "en" ? "ru" : "en";
const otherUrl = switchLocale(path, locale, other);
const otherShort = other.toUpperCase();

const items = [
  { href: homeUrl(locale), en: homeUrl("en"), label: dict.navHome },
  ...TOPICS.map((topic) => ({
    href: topicUrl(locale, topic),
    en: topicUrl("en", topic),
    label: topicTitle(topic),
  })),
  { href: entriesUrl(locale), en: entriesUrl("en"), label: dict.navEntries },
  { href: searchUrl(locale), en: searchUrl("en"), label: dict.navSearch },
  { href: aboutUrl(locale), en: aboutUrl("en"), label: dict.navAbout },
  { href: privacyUrl(locale), en: privacyUrl("en"), label: dict.navPrivacy },
];
---

{
  /*
    Rendered hidden; Header's script reveals it and turns the burger into a
    close button. `hidden` keeps the links out of the tab order while closed,
    and the panel is absolutely positioned against the header bar, so it opens
    under the burger at every width instead of against the viewport edge.
  */
}

<nav id="nav-drawer" hidden aria-label={dict.navLabel}>
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={item.href} aria-current={path === item.en ? "page" : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>

  {
    /*
      Controls, not navigation: a separator and a different shape keep the
      language switch from reading as one more menu link. Its visible text is
      the two-letter code, which the accessible name repeats, so WCAG 2.5.3
      still holds.
    */
  }
  <div class="drawer-tools">
    <ThemeToggle locale={locale} />
    <a
      class="lang-switch"
      href={otherUrl}
      hreflang={other}
      aria-label={`${otherShort} — ${dict.langSwitch}`}
    >
      {otherShort}
    </a>
  </div>
</nav>

<style>
  #nav-drawer {
    position: absolute;
    top: calc(100% + 0.25rem);
    right: 1rem;
    z-index: 30;
    width: min(22rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 8rem);
    overflow-y: auto;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background-color: var(--bg);
    box-shadow: 0 8px 24px rgb(0 0 0 / 15%);
    color: var(--fg);
    font-family: var(--font-sans);
  }

  /* Not `display: none` from a class — the attribute has to win here. */
  #nav-drawer[hidden] {
    display: none;
  }

  #nav-drawer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #nav-drawer li {
    margin-bottom: 0.25rem;
  }

  #nav-drawer li a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    color: var(--fg);
    text-decoration: none;
  }

  /* A hover row and a current-page bar, so the links read as rows in the same
     control language as the pill beside them. */
  #nav-drawer li a:hover {
    background-color: var(--bg-subtle);
  }

  #nav-drawer li a[aria-current="page"] {
    background-color: var(--bg-subtle);
    box-shadow: inset 3px 0 0 var(--accent);
    color: var(--accent);
    font-weight: 600;
  }

  .drawer-tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  /* Same box as the theme toggle beside it, so the two read as one group of
     controls and nothing like the plain links above. */
  .lang-switch {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--fg);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
  }

  .lang-switch:hover {
    border-color: var(--fg-muted);
    text-decoration: none;
  }
</style>
