---
import { TOPICS, topicTitle, type Locale } from "../lib/corpus";
import { getDict } from "../lib/dictionary";
import {
  aboutUrl,
  entriesUrl,
  homeUrl,
  privacyUrl,
  searchUrl,
  switchLocale,
  topicUrl,
} from "../lib/urls";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  /** The locale-neutral English path of the current page, for `aria-current`. */
  path?: string;
}

const { locale, path = "" } = Astro.props;
const dict = getDict(locale);

const other: Locale = locale === "en" ? "ru" : "en";
const otherUrl = switchLocale(path, locale, other);
const otherName = other === "ru" ? "Русский" : "English";

const items = [
  { href: homeUrl(locale), en: homeUrl("en"), label: dict.navHome },
  ...TOPICS.map((topic) => ({
    href: topicUrl(locale, topic),
    en: topicUrl("en", topic),
    label: topicTitle(topic),
  })),
  { href: entriesUrl(locale), en: entriesUrl("en"), label: dict.navEntries },
  { href: searchUrl(locale), en: searchUrl("en"), label: dict.navSearch },
  { href: aboutUrl(locale), en: aboutUrl("en"), label: dict.navAbout },
  { href: privacyUrl(locale), en: privacyUrl("en"), label: dict.navPrivacy },
];
---

<dialog id="nav-drawer" aria-label={dict.navLabel}>
  <div class="drawer-head">
    <ThemeToggle locale={locale} />
    <button class="close" id="nav-close" type="button" aria-label={dict.menuClose}>
      <span aria-hidden="true">✕</span>
    </button>
  </div>
  <nav aria-label={dict.navLabel}>
    <ul>
      {
        items.map((item) => (
          <li>
            <a href={item.href} aria-current={path === item.en ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={otherUrl} hreflang={other} aria-label={`${otherName} — ${dict.langSwitch}`}>
          {otherName}
        </a>
      </li>
    </ul>
  </nav>
</dialog>

<script>
  const drawer = document.getElementById("nav-drawer");

  if (drawer instanceof HTMLDialogElement) {
    // The burger lives in Header and cannot call this directly, so it asks.
    drawer.addEventListener("nav:open", () => drawer.showModal());

    // Close on activation: on a phone the drawer is the only way to navigate.
    drawer.querySelectorAll("a[href]").forEach((link) => {
      link.addEventListener("click", () => drawer.close());
    });
    document.getElementById("nav-close")?.addEventListener("click", () => drawer.close());
  }
</script>

<style>
  #nav-drawer {
    width: min(22rem, 90vw);
    margin: 0 0 0 auto;
    padding: 1rem;
    border: 0;
    max-height: 100dvh;
    overflow-y: auto;
    background-color: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
  }

  #nav-drawer::backdrop {
    background-color: rgb(0 0 0 / 40%);
  }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  #nav-drawer .close {
    min-width: 44px;
    min-height: 44px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: none;
    color: var(--fg);
    font-size: 1rem;
    cursor: pointer;
  }

  #nav-drawer ul {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  #nav-drawer li {
    margin-bottom: 0.25rem;
  }

  #nav-drawer a {
    display: block;
    padding: 0.5rem 0.25rem;
    color: var(--fg);
    text-decoration: none;
  }

  #nav-drawer a:hover {
    text-decoration: underline;
  }

  #nav-drawer a[aria-current="page"] {
    color: var(--accent);
    font-weight: 600;
  }
</style>
