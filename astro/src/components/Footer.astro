---
import { type Locale } from "../lib/corpus";
import { getDict } from "../lib/dictionary";
import { aboutUrl, privacyUrl } from "../lib/urls";

interface Props {
  locale: Locale;
  /** The locale-neutral English path of the current page. */
  path: string;
}

const { locale } = Astro.props;
const dict = getDict(locale);
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-links">
      <a href={aboutUrl(locale)}>{dict.navAbout}</a>
      <a href={privacyUrl(locale)}>{dict.navPrivacy}</a>
    </p>

    <p class="rights">{dict.footerRights}</p>

    <p class="credit">
      <a href="https://ctdev.dev/" target="_blank" rel="noopener noreferrer">Made by CTDev</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    border-top: 1px solid var(--border);
    background-color: var(--bg-subtle);
    font-family: var(--font-sans);
  }

  .footer-inner {
    display: grid;
    gap: 1rem;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: 1.5rem 1rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
    font-size: 0.9375rem;
  }

  .rights {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }

  /* The signature stays at --fg-muted with no opacity: opacity 0.6 measured
     2.26:1 here, far under WCAG AA, while the token alone reaches 7.6:1. */
  .credit {
    margin: 0;
  }

  .credit a {
    font-size: 0.65rem;
    color: var(--fg-muted);
    text-decoration: none;
  }

  .credit a:hover {
    text-decoration: underline;
  }
</style>
