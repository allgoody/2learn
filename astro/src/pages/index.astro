---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import { TOPICS, topicBlurb, topicTitle, type Locale } from "../lib/corpus";
import { getDict } from "../lib/dictionary";
import { entriesOfTopic } from "../lib/graph";
import { topicUrl } from "../lib/urls";

const locale: Locale = "en";
const dict = getDict(locale);
const path = "/";

const topics = TOPICS.map((topic) => ({
  topic,
  url: topicUrl(locale, topic),
  title: topicTitle(topic),
  blurb: topicBlurb(topic),
  count: entriesOfTopic(topic).length,
}));
---

<BaseLayout
  locale={locale}
  title={dict.homeTitle}
  description={dict.siteTagline}
  path={path}
>
  <Header slot="header" locale={locale} path={path} />

  <h1>{dict.homeTitle}</h1>
  <p class="tagline">{dict.siteTagline}</p>

  <ul class="topic-grid">
    {
      topics.map((item) => (
        <li class="topic-card">
          <p class="topic-head">
            <a class="topic-link" href={item.url}>
              {item.title}
            </a>
            <span class="topic-count">{item.count}</span>
          </p>
          <p class="topic-blurb">{item.blurb}</p>
        </li>
      ))
    }
  </ul>

  <Footer slot="footer" locale={locale} path={path} />
  <ScrollToTop locale={locale} />
</BaseLayout>

<style>
  .tagline {
    margin-top: 0;
    color: var(--fg-muted);
  }

  .topic-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .topic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .topic-card {
    position: relative;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  .topic-card:hover {
    background-color: var(--bg-subtle);
  }

  /* The link's own pseudo-element covers the card, so the whole card is the
     click target while the link text stays the accessible name. */
  .topic-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  /* The ring is drawn on the overlay, not the inline link, so keyboard focus
     outlines the whole card instead of just the words inside it. */
  .topic-link:focus-visible {
    outline: none;
  }

  .topic-link:focus-visible::after {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .topic-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0;
  }

  .topic-link {
    font-weight: 600;
  }

  .topic-count {
    flex: none;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  .topic-blurb {
    margin: 0.25rem 0 0;
    color: var(--fg-muted);
  }
</style>
