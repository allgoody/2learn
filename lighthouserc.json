{
  "ci": {
    "collect": {
      "staticDistDir": "./astro/dist",
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile"
      },
      "url": [
        "http://localhost/index.html",
        "http://localhost/02-frontend/03-html/index.html",
        "http://localhost/02-frontend/06-javascript/index.html",
        "http://localhost/ru/02-frontend/03-html/index.html",
        "http://localhost/entries/index.html",
        "http://localhost/ru/glossary/index.html",
        "http://localhost/search/index.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }]
      }
    }
  }
}
